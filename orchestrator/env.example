# LLM Configuration
# Set LLM_PROVIDER to 'openai' or 'anthropic'
# For OpenAI (ChatGPT): Use 'openai' and your OpenAI API key
# For Anthropic (Claude): Use 'anthropic' and your Anthropic API key
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-openai-api-key-here
# Recommended: gpt-4-turbo (128k context, cheaper, no truncation needed)
# Alternatives: gpt-4 (8k context), gpt-4-32k (32k context, more expensive)
LLM_MODEL=gpt-4-turbo

# Server Configuration
PORT=3002

# Orchestrator Configuration
AUTO_APPROVE=false
MAX_RETRIES=3
TIMEOUT=300000
